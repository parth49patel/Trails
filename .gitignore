# ==========================================
# 1. Firebase & Cloud Secrets (CRITICAL)
# ==========================================
# Firebase configuration containing project keys & client IDs
GoogleService-Info.plist
*GoogleService-Info*.plist

# Firebase / GCP service account private keys (if any backend/scripts are kept here)
*.json
!Package.resolved
!project.pbxproj
# If you use specific JSON files in your project (e.g., mock data), uncomment and whitelist them:
# !TrailPulse/Preview\ Content/mock_trails.json

# Apple developer private keys, certificates, and auth keys (.p8, .p12, .cer, .mobileprovision)
*.p8
*.p12
*.cer
*.mobileprovision
*.pem
*.key

# Environment files and custom secret property lists
.env
.env.*
Secrets.plist
Config.plist
Credentials.plist

# ==========================================
# 2. Xcode User Data & Cache
# ==========================================
# User-specific scheme settings, breakpoints, and window layouts
xcuserdata/
*.xcuserdatad
*.xcscmblueprint

# Build and derived data artifacts
build/
DerivedData/
*.moved-aside

# Crash logs and archives
*.crash
*.xcarchive

# Playground user state
timeline.xctimeline
playground.xcworkspace

# ==========================================
# 3. Swift Package Manager (SPM)
# ==========================================
# Cache directory generated by SPM
.build/

# Do NOT ignore Package.resolved if you want deterministic package builds across machines.
# If you prefer to track package versions strictly:
# !Package.resolved

# ==========================================
# 4. CocoaPods / Carthage (if applicable)
# ==========================================
Pods/
Carthage/Build/
Carthage/Checkouts/

# ==========================================
# 5. OS & IDE Metadata
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db